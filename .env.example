APP_NAME=IGWA
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Gemini credentials, tried strictly in this order. Use ONE of these forms
# (precedence: GEMINI_API_KEYS > GEMINI_API_KEY_1..10 > legacy GEMINI_API_KEY):
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3,key4,key5
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...
# Failover tuning (seconds)
# GEMINI_REQUEST_TIMEOUT_SECONDS=90
# GEMINI_OVERALL_BUDGET_SECONDS=110
# GEMINI_SHARED_FAILURE_COOLDOWN_SECONDS=10
# GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
# GEMINI_QUOTA_COOLDOWN_SECONDS=3600
# GEMINI_BILLING_COOLDOWN_SECONDS=3600
# GEMINI_FORBIDDEN_COOLDOWN_SECONDS=3600
# gemini-3.1-flash-lite: fast and verified. gemini-3-flash-preview is slower (~3x) but may read handwriting better.
# (gemini-3.8-flash / gemini-3.5-flash timed out on every key when tested; gemini-2.5-* is retired for new users.)
GEMINI_MODEL=gemini-3.1-flash-lite

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

MAX_FILE_SIZE_MB=20

# --- OCR: Gemini (ordered key failover) -> Groq ---
OCR_ENABLE_GEMINI_FALLBACK=true
OCR_ENABLE_GROQ_FALLBACK=true
OCR_GEMINI_MAX_RETRIES=1
OCR_GROQ_MAX_RETRIES=1
